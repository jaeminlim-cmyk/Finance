# ── 운용 모드 ────────────────────────────────────────────────
# 1단계에서는 paper 만 허용됩니다. 다른 값을 넣으면 서버가 시작을 거부합니다.
TRADING_MODE=paper

# 데이터: mock(샘플 데이터, 키 불필요) | live(yfinance 등 실제 시세)
DATA_MODE=mock

# LLM: mock(가짜 응답, 비용 0) | anthropic(Claude 호출, 비용 발생)
LLM_MODE=mock

# ── API 키 (필요한 것만) ─────────────────────────────────────
# LLM_MODE=anthropic 일 때 필요
ANTHROPIC_API_KEY=
# 뉴스(선택). 없으면 yfinance 뉴스만 사용
FINNHUB_API_KEY=
# 커뮤니티(선택). 없으면 StockTwits 공개 스트림만 시도
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── 경로 (보통은 건드릴 필요 없음) ───────────────────────────
# 기록 파일. 비워 두면 샘플 데이터는 data/fund.db, 실데이터는 data/fund-live.db 를 써서 서로 섞이지 않습니다.
# DB_PATH=
FUND_CONFIG=config/fund.toml
